      "item": [
        {
          "id": "06135fa0-63ee-4d0c-b2aa-d3ad2dd776dd",
          "name": "Domain Availability Check with Suggestions",
          "request": {
            "name": "Domain Availability Check with Suggestions",
            "description": {
              "content": "Check availability of a single domain and optionally get suggestions across multiple TLDs. 1 credit per domain checked. sug=false checks only the queried domain; sug=true returns up to `count` (max 100) TLD suggestions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2.0",
                "domain",
                "availability"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "(Required) The domain name to check"
                },
                {
                  "disabled": false,
                  "key": "sug",
                  "value": "false",
                  "description": "Whether to return TLD suggestions alongside the queried domain."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "5",
                  "description": "Number of TLD suggestions to return when sug=true. Maximum is 100."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
