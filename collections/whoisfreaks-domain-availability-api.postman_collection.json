          "request": {
            "name": "Bulk Domain Availability Check",
            "description": {
              "content": "Two bulk modes. Mode 1: POST domainNames array. Mode 2: POST tld array plus domain query param. Max 100 domains per request. 1 credit per domain checked.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2.0",
                "domain",
                "availability"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Required for TLD-mode bulk check (base domain)."
