            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.whoisfreaks.com/v1.0/security",
            "params": [
              {
                "name": "ip",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Threat intel for IP — VPN, proxy, Tor, bots. 1 credit."
        },
        {
          "info": {
            "name": "Bulk IP Reputation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.whoisfreaks.com/v1.0/security",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Up to 100 IPs."
        }
      ]
    }
  ],
  "bundled": true
}