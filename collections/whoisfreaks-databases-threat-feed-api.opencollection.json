          },
          "http": {
            "method": "GET",
            "url": "https://api.whoisfreaks.com/v3.4/download/threat-feed/spam/sample"
          },
          "docs": "Download a sample of the spam threat feed (CSV)"
        }
      ]
    }
  ],
  "bundled": true
}