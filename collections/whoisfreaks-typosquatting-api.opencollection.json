{
  "opencollection": "1.0.0",
  "info": {
    "name": "WhoisFreaks Typosquatting API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Typosquatting",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Typosquatting Lookup",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.whoisfreaks.com/v3.0/domain/typos",
            "params": [
              {
                "name": "keyword",
                "value": "",
                "type": "query"
              },
              {
                "name": "pattern",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Find typo variants of a brand. 5 credits per page."
        }
      ]
    }
  ],
  "bundled": true
}