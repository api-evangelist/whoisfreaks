{
  "opencollection": "1.0.0",
  "info": {
    "name": "WhoisFreaks Databases - IP WHOIS API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Databases - IP WHOIS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "IP WHOIS Snapshot",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.whoisfreaks.com/v3.3/download/snapshot/ip/whois",
            "params": [
              {
                "name": "date",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "IP WHOIS Snapshot. Returns the file/snapshot described by this operation."
        },
        {
          "info": {
            "name": "IP WHOIS Snapshot Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.whoisfreaks.com/v3.3/status/snapshot/ip/whois"
          },
          "docs": "IP WHOIS Snapshot Status. Returns the file/snapshot described by this operation."
        }
      ]
    }
  ],
  "bundled": true
}